default_platform(:android)

platform :android do
  lane :build_apk do
    gradle(
      task: "assemble",
      build_type: 'Debug'
    )
  end

  desc "Run unit tests"
    lane :unit_tests do
        gradle(
        task: "test",
        print_command: false,
        properties: {
          "color" => "always"
        }
        )
    end

